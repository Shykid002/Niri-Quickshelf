animations {
    slowdown 1.15

    // Smooth paper-sheet rise + scale-in (88% -> 100%) on open
    window-open {
        duration-ms 260
        curve "ease-out-cubic"
        custom-shader r"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                float scale = mix(0.88, 1.0, p);
                vec2 center = vec2(0.5, 0.5);
                vec2 uv = (coords_geo.xy - center) / scale + center;
                uv.y += (1.0 - p) * 0.06;
                if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) {
                    return vec4(0.0);
                }
                vec3 coords_tex = niri_geo_to_tex * vec3(uv, 1.0);
                vec4 color = texture2D(niri_tex, coords_tex.st);
                return color * p;
            }
        "
    }

    // Clear shrink-and-tuck (100% -> 82%) on close
    window-close {
        duration-ms 280
        curve "ease-out-cubic"
        custom-shader r"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = 1.0 - niri_clamped_progress;
                float scale = mix(0.82, 1.0, p);
                vec2 center = vec2(0.5, 0.5);
                vec2 uv = (coords_geo.xy - center) / scale + center;
                uv.y -= (1.0 - p) * 0.08;
                if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) {
                    return vec4(0.0);
                }
                vec3 coords_tex = niri_geo_to_tex * vec3(uv, 1.0);
                vec4 color = texture2D(niri_tex, coords_tex.st);
                return color * (p * p);
            }
        "
    }

    // Expressive spring when dragging or swapping windows
    window-movement {
        spring damping-ratio=0.72 stiffness=520 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=0.75 stiffness=550 epsilon=0.0001
    }

    horizontal-view-movement {
        spring damping-ratio=0.78 stiffness=520 epsilon=0.0001
    }

    workspace-switch {
        spring damping-ratio=0.78 stiffness=520 epsilon=0.0001
    }

    overview-open-close {
        spring damping-ratio=0.76 stiffness=560 epsilon=0.0001
    }
}
