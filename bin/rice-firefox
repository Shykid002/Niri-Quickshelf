#!/bin/sh
# rice-firefox install        link the stylesheets into every Firefox profile, enable them, write the cover colour
# rice-firefox cover NAME     rewrite the cover colour (Paper/Ink flips live via prefers-color-scheme)
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
cmd="${1:-install}"
cover="${2:-sky}"

case $cover in
  indigo) l=2C3E60; d=6D84AF;;
  ochre)  l=CF9C42; d=D7AD59;;
  pine)   l=486455; d=7C9987;;
  plum)   l=7D3B56; d=C47A98;;
  umber)  l=6B4C3B; d=B58E79;;
  mint)   l=A6E3A1; d=A6E3A1;;
  sakura) l=F5C2E7; d=F5C2E7;;
  sand)   l=E1D2B0; d=E1D2B0;;
  *)      l=7DCFFF; d=7DCFFF;;
esac

profiles() {
  for base in "$HOME/.config/mozilla/firefox" "$HOME/.mozilla/firefox" "$HOME/.var/app/org.mozilla.firefox/.mozilla/firefox" "$HOME/snap/firefox/common/.mozilla/firefox"; do
    [ -f "$base/profiles.ini" ] || continue
    sed -n 's/^Path=//p' "$base/profiles.ini" | while read -r p; do
      case $p in /*) [ -d "$p" ] && echo "$p";; *) [ -d "$base/$p" ] && echo "$base/$p";; esac
    done
  done
}

profiles | while read -r prof; do
  mkdir -p "$prof/chrome"
  if [ "$cmd" = cover ] || [ ! -f "$prof/chrome/rice-cover.css" ]; then
    {
      printf ':root { --rice-accent: #%s; --rice-paper: #EEEAE1; --rice-block: #E2DCCF; --rice-ink: #1D1C1A; --rice-muted: #8A8478; --rice-rule: #C8C0B1; }\n' "$l"
      printf '@media (prefers-color-scheme: dark) { :root { --rice-accent: #%s; --rice-paper: #171619; --rice-block: #222023; --rice-ink: #E7E2D5; --rice-muted: #8F8A80; --rice-rule: #3A3636; } }\n' "$d"
    } > "$prof/chrome/rice-cover.css"
  fi
  if [ "$cmd" = install ]; then
    ln -sf "$root/firefox/userChrome.css"  "$prof/chrome/userChrome.css"
    ln -sf "$root/firefox/userContent.css" "$prof/chrome/userContent.css"
    [ -f "$prof/user.js" ] && sed -i '/^\/\/ rice-begin/,/^\/\/ rice-end/d' "$prof/user.js"
    { echo "// rice-begin"; cat "$root/firefox/user.js"; echo "// rice-end"; } >> "$prof/user.js"
  fi
done
exit 0
