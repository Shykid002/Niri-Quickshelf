#!/usr/bin/env python3
"""rice-icons COVER MODE : tint Papirus folder SVGs to match the exact Paper & Ink cover hex."""
import configparser, os, re, shutil, subprocess, sys
from operator import itemgetter

def load_covers():
    """name -> (light, dark) from quickshell/assets/covers.tsv (the one shared cover list)."""
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "quickshell", "assets", "covers.tsv")
    out = dict()
    try:
        with open(path, encoding="utf-8") as fp:
            for line in fp:
                c = line.rstrip("\n").split("\t")
                if len(c) >= 3 and not line.startswith("#"):
                    out[c[0]] = ("#" + c[1].lstrip("#"), "#" + c[2].lstrip("#"))
    except OSError:
        pass
    out.setdefault("sky", ("#7DCFFF", "#7DCFFF"))
    return out

PALETTE = load_covers()

def is_light(h):
    """True when dark text reads better on this colour (same rule as rice-theme)."""
    h = h.lstrip("#")
    def lin(v):
        v = v / 255
        return v / 12.92 if v <= 0.03928 else ((v + 0.055) / 1.055) ** 2.4
    r, g, b = (lin(int(h[i:i + 2], 16)) for i in (0, 2, 4))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.179

def adjust_hex(h, factor):
    h = h.lstrip("#")
    r = max(0, min(255, int(int(h[0:2], 16) * factor)))
    g = max(0, min(255, int(int(h[2:4], 16) * factor)))
    b = max(0, min(255, int(int(h[4:6], 16) * factor)))
    return "#%02x%02x%02x" % (r, g, b)

it = iter(sys.argv)
next(it, None)
cover = next(it, "sky").lower()
mode  = next(it, "light").lower()

light_hex, dark_hex = PALETTE.get(cover, PALETTE.get("sky"))
body_hex = dark_hex if mode == "dark" else light_hex
tab_hex  = adjust_hex(body_hex, 0.80)
emblem_hex = "#171619" if (mode == "dark" or is_light(body_hex)) else "#EEEAE1"

search = os.environ.get("RICE_ICON_DIRS", "/usr/share/icons:" + os.path.expanduser("~/.local/share/icons")).split(":")
out = os.path.join(os.path.expanduser(os.environ.get("RICE_ICON_OUT", "~/.local/share/icons")), "Rice-Papirus")

def find(name):
    for d in search:
        p = os.path.join(d, name)
        if os.path.isfile(os.path.join(p, "index.theme")):
            return p
    return None

base_name = next((n for n in (("Papirus-Dark", "Papirus") if mode == "dark" else ("Papirus-Light", "Papirus")) if find(n)), None)
if not base_name:
    print("Papirus not found", file=sys.stderr)
    sys.exit(2)
base = find(base_name)

idx = configparser.ConfigParser(interpolation=None, strict=False)
idx.optionxform = str
idx.read(os.path.join(base, "index.theme"), encoding="utf-8")
dirs   = tuple(d.strip() for d in idx.get("Icon Theme", "Directories", fallback="").split(",") if d.strip())
places = tuple(d for d in dirs if d.endswith("/places") and os.path.isdir(os.path.join(base, d)))
mimes  = {itemgetter(0)(d.rsplit("/", 1)): d for d in dirs if d.endswith("/mimetypes")}

pat = re.compile(r"^(folder|user)-blue(?=-|\.svg$)")
shutil.rmtree(out, ignore_errors=True)
made, used = 0, list()

def tint_svg(svg_text):
    s = re.sub(r"#4877b1", tab_hex, svg_text, flags=re.IGNORECASE)
    s = re.sub(r"#5294e2", body_hex, s, flags=re.IGNORECASE)
    s = re.sub(r"#1d344f", emblem_hex, s, flags=re.IGNORECASE)
    return s

for d in places:
    src = os.path.join(base, d)
    dst = os.path.join(out, d)
    n = 0
    for f in sorted(os.listdir(src)):
        if not f.endswith(".svg") or not pat.match(f):
            continue
        name = pat.sub(lambda m: m.group(1), f)
        os.makedirs(dst, exist_ok=True)
        src_file = os.path.realpath(os.path.join(src, f))
        dst_file = os.path.join(dst, name)
        with open(src_file, "r", encoding="utf-8", errors="ignore") as fp:
            raw = fp.read()
        with open(dst_file, "w", encoding="utf-8") as fp:
            fp.write(tint_svg(raw))
        n += 1
    if n:
        made += n
        used.append(d)
        m = mimes.get(itemgetter(0)(d.rsplit("/", 1)))
        if m and os.path.exists(os.path.join(dst, "folder.svg")):
            md = os.path.join(out, m)
            os.makedirs(md, exist_ok=True)
            link = os.path.join(md, "inode-directory.svg")
            if os.path.lexists(link):
                os.remove(link)
            os.symlink(os.path.join(dst, "folder.svg"), link)
            used.append(m)

if made == 0:
    shutil.rmtree(out, ignore_errors=True)
    print("No icons written", file=sys.stderr)
    sys.exit(2)

lines = list((
    "[Icon Theme]",
    "Name=Rice Papirus",
    "Comment=%s tinted to exact cover hex (%s)" % (base_name, body_hex),
    "Inherits=%s,Papirus,hicolor" % base_name if base_name != "Papirus" else "Inherits=Papirus,hicolor",
    "Directories=" + ",".join(used),
    "",
))
for d in used:
    lines.append("[%s]" % d)
    for k, v in idx.items(d) if idx.has_section(d) else ():
        lines.append("%s=%s" % (k, v))
    lines.append("")

with open(os.path.join(out, "index.theme"), "w", encoding="utf-8") as fp:
    fp.write("\n".join(lines))

if shutil.which("gtk-update-icon-cache"):
    subprocess.run(("gtk-update-icon-cache", "-f", "-t", out), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

print("Rice-Papirus: %d folder icons -> %s (%s on %s)" % (made, body_hex, cover, base_name))
