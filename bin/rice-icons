#!/usr/bin/env python3
"""rice-icons COVER MODE : make Papirus folders follow the cover colour.

Papirus ships every folder icon in many colours (folder-blue.svg, folder-deeporange-documents.svg ...)
and `folder.svg` is just a link to one of them. This builds a small user theme, ~/.local/share/icons/Rice-Papirus,
that inherits Papirus and links folder*.svg / user-*.svg to the colour that matches your cover.
Needs the papirus-icon-theme package. Exit code 0 = theme written, 2 = Papirus not found / no colour variants."""
import configparser, os, re, shutil, subprocess, sys

# cover colour -> nearest Papirus folder colour. Edit this table to taste.
# (Papirus has: adwaita black blue bluegrey breeze brown carmine cyan darkcyan deeporange green grey indigo
#  magenta nordic orange palebrown paleorange pink red teal violet white yellow yaru)
COLORS = {"red": "deeporange", "mix": "deeporange", "indigo": "indigo", "ochre": "orange", "pine": "green"}

cover = (sys.argv[1] if len(sys.argv) > 1 else "red").lower()
mode = sys.argv[2] if len(sys.argv) > 2 else "light"
color = COLORS.get(cover, "deeporange")
search = os.environ.get("RICE_ICON_DIRS", "/usr/share/icons:" + os.path.expanduser("~/.local/share/icons")).split(":")
out = os.path.join(os.path.expanduser(os.environ.get("RICE_ICON_OUT", "~/.local/share/icons")), "Rice-Papirus")

def find(name):
    for d in search:
        p = os.path.join(d, name)
        if os.path.isfile(os.path.join(p, "index.theme")): return p
    return None

# the variant that suits the theme, else plain Papirus
base_name = next((n for n in (["Papirus-Dark", "Papirus"] if mode == "dark" else ["Papirus-Light", "Papirus"]) if find(n)), None)
if not base_name:
    print("Papirus not found (install papirus-icon-theme)", file=sys.stderr); sys.exit(2)
base = find(base_name)

idx = configparser.ConfigParser(interpolation=None, strict=False); idx.optionxform = str
idx.read(os.path.join(base, "index.theme"), encoding="utf-8")
dirs = [d.strip() for d in idx.get("Icon Theme", "Directories", fallback="").split(",") if d.strip()]
places = [d for d in dirs if d.endswith("/places") and os.path.isdir(os.path.join(base, d))]
mimes  = {d.rsplit("/", 1)[0]: d for d in dirs if d.endswith("/mimetypes")}

pat = re.compile(r"^(folder|user)-%s(?=-|\.svg$)" % re.escape(color))
shutil.rmtree(out, ignore_errors=True)
made, used = 0, []
for d in places:
    src = os.path.join(base, d); dst = os.path.join(out, d); n = 0
    for f in sorted(os.listdir(src)):
        if not f.endswith(".svg") or not pat.match(f): continue
        name = pat.sub(lambda m: m.group(1), f)                 # folder-deeporange-documents.svg -> folder-documents.svg
        os.makedirs(dst, exist_ok=True)
        link = os.path.join(dst, name)
        if os.path.lexists(link): os.remove(link)
        os.symlink(os.path.realpath(os.path.join(src, f)), link); n += 1
    if n:
        made += n; used.append(d)
        m = mimes.get(d.rsplit("/", 1)[0])                      # directories in file managers use inode-directory
        if m and os.path.exists(os.path.join(dst, "folder.svg")):
            md = os.path.join(out, m); os.makedirs(md, exist_ok=True)
            link = os.path.join(md, "inode-directory.svg")
            if os.path.lexists(link): os.remove(link)
            os.symlink(os.path.join(dst, "folder.svg"), link); used.append(m)

if made == 0:
    shutil.rmtree(out, ignore_errors=True)
    print("no %s folder icons in %s (Papirus too old?)" % (color, base_name), file=sys.stderr); sys.exit(2)

lines = ["[Icon Theme]", "Name=Rice Papirus", "Comment=%s with folders in the cover colour (%s)" % (base_name, color),
         "Inherits=%s,Papirus,hicolor" % base_name if base_name != "Papirus" else "Inherits=Papirus,hicolor",
         "Directories=" + ",".join(used), ""]
for d in used:
    lines.append("[%s]" % d)
    for k, v in idx.items(d) if idx.has_section(d) else []: lines.append("%s=%s" % (k, v))
    lines.append("")
open(os.path.join(out, "index.theme"), "w").write("\n".join(lines))
if shutil.which("gtk-update-icon-cache"):
    subprocess.run(["gtk-update-icon-cache", "-f", "-t", out], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
print("Rice-Papirus: %d folder icons -> %s (on %s)" % (made, color, base_name))
