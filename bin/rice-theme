#!/bin/sh
# rice-theme dark|light [cover] : flip everything outside the shell (cursor, niri, kitty, fastfetch, GTK, Qt, Icons, Firefox).
# cover = any name in quickshell/assets/covers.tsv, or mix (unknown names fall back to sky)
mode="${1:-light}"
cstyle="${3:-box}"
csize="${4:-24}"
mkdir -p "$HOME/.cache"

# one run at a time: rapid cover clicks queue up instead of racing on Rice-A/B and the icon theme
if command -v flock >/dev/null 2>&1; then
  exec 9>"$HOME/.cache/rice-theme.lock"
  flock 9
fi

if [ -n "${2:-}" ]; then
  cover="$2"
  printf '%s' "$cover" > "$HOME/.cache/rice-cover"
elif [ -f "$HOME/.cache/rice-cover" ]; then
  cover="$(cat "$HOME/.cache/rice-cover")"
else
  cover="sky"
fi

root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
tsv="$root/quickshell/assets/covers.tsv"

# covers.tsv: name <tab> light <tab> dark <tab> label <tab> gnome-accent
row() { [ -f "$tsv" ] && awk -F'\t' -v n="$1" '$1 !~ /^#/ && $1 == n { print $2 " " $3 " " $5; exit }' "$tsv"; }
vals="$(row "$cover")"
if [ -n "$vals" ]; then ckey="$cover"; else ckey=sky; vals="$(row sky)"; fi
[ -n "$vals" ] || vals="7DCFFF 7DCFFF teal"
set -- $vals
lhex=$1; dhex=$2; gaccent=$3

if [ "$mode" = dark ]; then hex=$dhex; else hex=$lhex; fi
if [ "$mode" = dark ]; then name=ink; else name=paper; fi

r=$(printf '%d' 0x$(echo "$hex" | cut -c1-2))
g=$(printf '%d' 0x$(echo "$hex" | cut -c3-4))
b=$(printf '%d' 0x$(echo "$hex" | cut -c5-6))
rgb="$r;$g;$b"

# text colour on top of the cover: the one with better contrast (same rule as rice-icons)
if [ "$mode" = dark ]; then
  fg=171619
else
  tone="$(awk -v r="$r" -v g="$g" -v b="$b" 'function lin(c){c/=255; return c<=0.03928 ? c/12.92 : ((c+0.055)/1.055)^2.4}
          BEGIN{ L=0.2126*lin(r)+0.7152*lin(g)+0.0722*lin(b); print (L>0.179) ? "dark" : "light" }')"
  if [ "$tone" = dark ]; then fg=1D1C1A; else fg=EEEAE1; fi
fi

cursor="rice-$name-$cstyle-$ckey"

mkdir -p "$HOME/.config/niri"
  sed -e "s/__COVER__/#$hex/g" -e "s/__CURSOR__/$cursor/g" -e "s/__CURSOR_SIZE__/${csize:-24}/g" "$root/niri/$name.kdl" > "$HOME/.config/niri/theme.kdl"

# kitty
mkdir -p "$HOME/.config/kitty" "$HOME/.config/zathura"
[ -f "$root/kitty/rice-$name.conf" ] && sed -e "s/^cursor #.*/cursor #$hex/" -e "s/^url_color #.*/url_color #$hex/" \
  "$root/kitty/rice-$name.conf" > "$HOME/.config/kitty/theme.conf"
pkill -USR1 -x kitty 2>/dev/null
[ -f "$root/zathura/$name" ] && cp "$root/zathura/$name" "$HOME/.config/zathura/theme"

# btop
mkdir -p "$HOME/.config/btop/themes"
if [ -f "$root/btop/$name.theme" ]; then
  sed -e "s/__COVER__/#$hex/g" -e "s/__COVER_FG__/#$fg/g" \
    "$root/btop/$name.theme" > "$HOME/.config/btop/themes/rice.theme"
  pkill -USR2 -x btop 2>/dev/null
fi

# nvim
mkdir -p "$HOME/.config/nvim/colors"
if [ -f "$root/nvim/rice.lua.in" ]; then
  nvim_bg="light"
  [ "$name" = "ink" ] && nvim_bg="dark"
  sed -e "s/__MODE__/$nvim_bg/g" -e "s/__COVER__/#$hex/g" -e "s/__COVER_FG__/#$fg/g" \
    "$root/nvim/rice.lua.in" > "$HOME/.config/nvim/colors/rice.lua"
  for sock in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/nvim.*.0 "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/nvim/nvim.*.0; do
    [ -S "$sock" ] && nvim --server "$sock" --remote-send '<Cmd>colorscheme rice<CR>' >/dev/null 2>&1 &
  done
fi

# fastfetch
ff="$HOME/.config/fastfetch/config.jsonc"
if [ -f "$root/fastfetch/config.jsonc.in" ] && { [ ! -e "$ff" ] || [ -L "$ff" ] || grep -q "paper & ink rice" "$ff" 2>/dev/null; }; then
  mkdir -p "$HOME/.config/fastfetch"; rm -f "$ff"
  sed "s/__COVER_RGB__/$rgb/" "$root/fastfetch/config.jsonc.in" > "$ff"
fi

# GTK 3 + 4 (switchable Rice-A / Rice-B theme dirs so open GTK3 windows like Thunar reload live)
setini() { _f="$1"; _k="$2"; _v="$3"; [ -f "$_f" ] || printf '[Settings]\n' > "$_f"
           if grep -q "^$_k=" "$_f"; then sed -i "s|^$_k=.*|$_k=$_v|" "$_f"; else printf '%s=%s\n' "$_k" "$_v" >> "$_f"; fi; }
if [ "$mode" = dark ]; then basegtk=adw-gtk3-dark; preferdark=1; else basegtk=adw-gtk3; preferdark=0; fi

cur_gtk="$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null | tr -d "'")"
if [ "$cur_gtk" = "Rice-A" ]; then livegtk="Rice-B"; else livegtk="Rice-A"; fi

themedir="$HOME/.local/share/themes/$livegtk"
mkdir -p "$themedir/gtk-3.0" "$themedir/gtk-4.0"
for gv in 3.0 4.0; do
  mkdir -p "$HOME/.config/gtk-$gv"
  {
    if [ "$mode" = dark ] && [ -f "/usr/share/themes/$basegtk/gtk-$gv/gtk-dark.css" ]; then
      printf '@import url("file:///usr/share/themes/%s/gtk-%s/gtk-dark.css");\n' "$basegtk" "$gv"
    elif [ -f "/usr/share/themes/$basegtk/gtk-$gv/gtk.css" ]; then
      printf '@import url("file:///usr/share/themes/%s/gtk-%s/gtk.css");\n' "$basegtk" "$gv"
    fi
    sed -e "s/__COVER__/#$hex/g" -e "s/__COVER_FG__/#$fg/g" "$root/gtk/$name.css"
    cat "$root/gtk/common.css"
  } > "$themedir/gtk-$gv/gtk.css"

  {
    sed -e "s/__COVER__/#$hex/g" -e "s/__COVER_FG__/#$fg/g" "$root/gtk/$name.css"
    cat "$root/gtk/common.css"
  } > "$HOME/.config/gtk-$gv/gtk.css"

  setini "$HOME/.config/gtk-$gv/settings.ini" gtk-theme-name "$livegtk"
  setini "$HOME/.config/gtk-$gv/settings.ini" gtk-application-prefer-dark-theme "$preferdark"
  setini "$HOME/.config/gtk-$gv/settings.ini" gtk-cursor-theme-name "$cursor"
done
gsettings set org.gnome.desktop.interface gtk-theme "$livegtk" 2>/dev/null

# xsettingsd live reload for GTK3 / XWayland apps
mkdir -p "$HOME/.config/xsettingsd"
cat << XEOF > "$HOME/.config/xsettingsd/xsettingsd.conf"
Net/ThemeName "$livegtk"
Net/IconThemeName "Rice-Papirus"
Gtk/CursorThemeName "$cursor"
Gtk/CursorThemeSize $csize
Gtk/ApplicationPreferDarkTheme $preferdark
XEOF
if pgrep -x xsettingsd >/dev/null 2>&1; then
  pkill -HUP -x xsettingsd 2>/dev/null
elif command -v xsettingsd >/dev/null 2>&1; then
  # 9>&- so the long-lived daemon does not inherit (and hold) the lock
  nohup xsettingsd >/dev/null 2>&1 9>&- &
fi

# Qt
for q in qt6ct qt5ct; do
  mkdir -p "$HOME/.config/$q/colors"
  sed -e "s/__COVER__/#$hex/g" -e "s/__COVER_FG__/#$fg/g" "$root/qt/rice-$name.conf" > "$HOME/.config/$q/colors/rice.conf"
  [ -f "$HOME/.config/$q/$q.conf" ] && touch "$HOME/.config/$q/$q.conf"
done

# Icons
if "$root/bin/rice-icons" "$cover" "$mode" >/dev/null 2>&1; then
  gsettings set org.gnome.desktop.interface icon-theme Papirus 2>/dev/null
  sleep 0.15
  gsettings set org.gnome.desktop.interface icon-theme Rice-Papirus 2>/dev/null
  for gv in 3.0 4.0; do setini "$HOME/.config/gtk-$gv/settings.ini" gtk-icon-theme-name Rice-Papirus; done
  for q in qt6ct qt5ct; do
    cf="$HOME/.config/$q/$q.conf"; [ -f "$cf" ] || continue
    if grep -q '^icon_theme=' "$cf"; then sed -i 's|^icon_theme=.*|icon_theme=Rice-Papirus|' "$cf"
    else sed -i '/^\[Appearance\]/a icon_theme=Rice-Papirus' "$cf"; fi
    touch "$cf"
  done
fi

# Firefox: the chrome follows the GTK selection colour (exact cover hex via accent_bg_color),
# the GNOME accent below is only the nearest-name fallback for apps that read the portal accent.
gsettings set org.gnome.desktop.interface accent-color "$gaccent" 2>/dev/null
"$root/bin/rice-firefox" cover "$cover" >/dev/null 2>&1

# Cursors & environment
mkdir -p "$HOME/.local/share/icons/default"
printf '[Icon Theme]\nName=Default\nInherits=%s\n' "$cursor" > "$HOME/.local/share/icons/default/index.theme"
systemctl --user set-environment XCURSOR_THEME="$cursor" 2>/dev/null
dbus-update-activation-environment --systemd XCURSOR_THEME="$cursor" 2>/dev/null

gsettings set org.gnome.desktop.interface cursor-theme "$cursor" 2>/dev/null
gsettings set org.gnome.desktop.interface cursor-size "$csize" 2>/dev/null
[ -n "$NIRI_SOCKET" ] && niri msg action load-config-file >/dev/null 2>&1
exit 0
