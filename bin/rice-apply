#!/bin/sh
# rice-apply GAPS BORDER TAP NATURAL FONT FOCUS_MOUSE DWT CURSOR_STYLE CURSOR_SIZE KB_LAYOUT
gaps="${1:--}" border="${2:--}" tap="${3:-0}" natural="${4:-0}" font="${5:--}"
focus_mouse="${6:-0}" dwt="${7:-1}" cstyle="${8:-box}" csize="${9:-24}" kblay="${10:-us}"

n="$HOME/.config/niri"; g="$HOME/.config/ghostty"; k="$HOME/.config/kitty"
mkdir -p "$n" "$g" "$k"

{
  echo "// written by rice-apply. Settings > Windows"
  echo "layout {"
  case $gaps in none) echo "    gaps 0;";; small) echo "    gaps 8;";; usual) echo "    gaps 16;";; esac
  case $border in thin) echo "    border { width 1; }";; usual) echo "    border { width 2; }";; thick) echo "    border { width 3; }";; esac
  echo "}"
} > "$n/rice-layout.kdl"

{
  echo "// written by rice-apply. Settings > Input"
  echo "input {"
  [ "$focus_mouse" = 1 ] && echo "    focus-follows-mouse;"
  echo '    mouse { accel-profile "flat"; }'
  echo "    keyboard {"
  echo "        xkb {"
  echo '            layout "us,ara"'
  echo "        }"
  echo "    }"
  echo "    touchpad {"
  echo '        accel-profile "flat";'
  [ "$tap" = 1 ] && echo "        tap;"
  [ "$natural" = 1 ] && echo "        natural-scroll;"
  [ "$dwt" = 1 ] && echo "        dwt;"
  echo "    }"
  echo "}"
} > "$n/rice-input.kdl"

{
  echo "# written by rice-apply. Settings > Terminal"
  case $font in small) echo "font-size = 12";; usual) echo "font-size = 13";; large) echo "font-size = 15";; esac
} > "$g/rice.conf"

{
  echo "# written by rice-apply. Settings > Terminal"
  case $font in small) echo "font_size 11.5";; usual) echo "font_size 13.0";; large) echo "font_size 15.0";; esac
} > "$k/rice.conf"

if [ -f "$k/kitty.conf" ] && ! grep -q '^include rice.conf' "$k/kitty.conf"; then
  printf '\ninclude rice.conf\n' >> "$k/kitty.conf"
fi
pkill -USR1 -x kitty 2>/dev/null || true

if [ -n "$NIRI_SOCKET" ]; then
  niri msg action load-config-file >/dev/null 2>&1
  if [ "$kblay" = "ara" ]; then
    niri msg action switch-layout 1 >/dev/null 2>&1 || true
  else
    niri msg action switch-layout 0 >/dev/null 2>&1 || true
  fi
fi
exit 0
