// fastfetch for the paper & ink rice (generated from fastfetch/config.jsonc.in by bin/rice-theme; do not edit this copy). ANSI colours only, so it follows kitty / Ghostty live.
// Logo: the cover block (ink square over one in the cover colour, set by bin/rice-theme). Keys: grey. Last line: the 8 palette swatches.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "$1██████            \n$1██████            \n$1██████$2████████████\n    $2██████████████\n    $2██████████████\n    $2██████████████\n    $2██████████████\n    $2██████████████\n    $2██████████████",
    "color": {
      "1": "39",
      "2": "38;2;__COVER_RGB__"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "   ",
    "color": {
      "keys": "90",
      "title": "39"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}  \u001b[90m{host-name}\u001b[0m"
    },
    "break",
    {
      "type": "os",
      "key": "System  "
    },
    {
      "type": "kernel",
      "key": "Kernel  "
    },
    {
      "type": "wm",
      "key": "Windows "
    },
    {
      "type": "shell",
      "key": "Shell   "
    },
    {
      "type": "terminal",
      "key": "Terminal"
    },
    {
      "type": "custom",
      "key": "Type    ",
      "format": "Courier Prime"
    },
    {
      "type": "packages",
      "key": "Packages",
      "format": "{all}"
    },
    "break",
    {
      "type": "uptime",
      "key": "Awake   ",
      "format": "{days} days, {hours} hours"
    },
    {
      "type": "memory",
      "key": "Memory  ",
      "format": "{used} of {total}"
    },
    {
      "type": "battery",
      "key": "Battery ",
      "format": "{capacity}, {status}"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[40m   \u001b[41m   \u001b[42m   \u001b[43m   \u001b[44m   \u001b[45m   \u001b[46m   \u001b[47m   \u001b[0m"
    }
  ]
}
